`timescale 1ns / 1ps

// ============================================================================
// 2x2 Max Pooling (Order-Based, TB-Safe)
// ---------------------------------------------------------------------------
// - Designed for HMNOC psum read streams
// - Groups every 4 reads into one pooling window
// - Outputs pooled value on 4th read
// - Pass-through otherwise (TB unchanged)
// ============================================================================

module pool_max_2x2_stream #(
    parameter DATA_BITWIDTH = 16
)(
    input                           clk,
    input                           reset,

    // Read request (same signal TB already drives)
    input                           r_req,

    // Data after ReLU
    input  signed [DATA_BITWIDTH-1:0] data_in,

    // Pooled output
    output reg signed [DATA_BITWIDTH-1:0] data_out
);

    // ------------------------------------------------------------------------
    // Internal state
    // ------------------------------------------------------------------------
    reg signed [DATA_BITWIDTH-1:0] max_reg;
    reg [1:0] cnt;   // counts 0,1,2,3

    // ------------------------------------------------------------------------
    // Pooling logic
    // ------------------------------------------------------------------------
    always @(posedge clk) begin
        if (reset) begin
            max_reg <= 'sd0;
            cnt     <= 2'd0;
            data_out<= 'sd0;
        end
        else if (r_req) begin
            // First value in window
            if (cnt == 2'd0)
                max_reg <= data_in;
            else if (data_in > max_reg)
                max_reg <= data_in;

            // Output logic
            if (cnt == 2'd3) begin
                data_out <= max_reg;  // pooled result
                cnt      <= 2'd0;
            end
            else begin
                data_out <= data_in;  // pass-through
                cnt      <= cnt + 2'd1;
            end
        end
    end

endmodule

